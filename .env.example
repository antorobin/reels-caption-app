# Copy this file to .env and fill in your own Firebase project's web config
# (Firebase console -> Project settings -> your web app -> SDK setup and
# configuration). These values are not secret -- Firebase enforces access
# control via security rules, not by hiding this config -- but .env itself
# is still gitignored so each developer/deployment can point at their own
# project without touching source.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
