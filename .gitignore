node_modules/
dist/
src-tauri/target/
src-tauri/gen/
.DS_Store
*.log
__pycache__/
*.pyc

# Per-developer Firebase project config — see .env.example.
.env

# Bundled ffmpeg binaries — fetched/copied locally per
# src-tauri/resources/bin/README.md, not vendored into git.
src-tauri/resources/bin/*.exe
src-tauri/resources/bin/*.dll

# Bundled llama.cpp binaries + the Qwen2.5-0.5B-Instruct GGUF model —
# fetched locally, not vendored into git (see README's LLM service setup
# section).
src-tauri/resources/llama/*.exe
src-tauri/resources/llama/*.dll
src-tauri/resources/llama/*.gguf

# Converted Indic Whisper checkpoints — large, per-language, fetched and
# converted locally (see src-tauri/resources/stt-models/README.md).
src-tauri/resources/stt-models/*/

# Bundled Piper voice for English TTS — fetched locally, not vendored into
# git (see README's voiceover setup section).
src-tauri/resources/tts-models/en/*.onnx
src-tauri/resources/tts-models/en/*.onnx.json

# OpenVoice V2 converter checkpoint — large, fetched locally (see README's
# voice cloning setup section).
src-tauri/resources/voice-clone-models/

# Bundled relocatable Python environments — built locally by
# `node scripts/build-python-runtime.mjs` from python-build-standalone +
# the pinned requirements/*.txt (see docs/RUNTIME-PACKS.md). Hundreds of MB
# per env; rebuilt, never vendored.
src-tauri/resources/python/

# All of the above (ffmpeg/ffprobe, llama.cpp+Qwen, Piper voices, the Tamil
# checkpoint, the OpenVoice checkpoint) are large, static binaries that
# never change once fetched — a poor fit for Git LFS, which bills by
# storage *and* per-clone bandwidth regardless of how often a file
# actually changes. `npm run fetch-resources` downloads all of them in one
# shot from the GitHub Release instead (see README) — no separate
# per-model hunting, and no LFS quota involved.

# OpenVoice's se_extractor caches VAD-split reference clips + speaker
# embeddings here by default (a *relative* path, resolved against
# whatever the current process's CWD happens to be) -- clone_voice.py
# pins this to an explicit temp directory instead, but excluded here too
# as a defensive backstop against it ever landing in the working tree
# again.
/processed/
src-tauri/processed/
