{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "Reels Caption App",
  "version": "0.1.0",
  "identifier": "com.yourname.reelscaptionapp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Reels Caption App",
        "width": 700,
        "height": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "resources/models/*": "models/"
    }
  }
}
