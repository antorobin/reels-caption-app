---
import { features } from '../config/site.js';
---

<section class="section" id="features">
  <div class="wrap">
    <span class="eyebrow">From creation to publication — without the tool switching</span>
    <h2 class="feat__title">Everything you need to craft better reels</h2>
    <p class="feat__lead muted">
      No separate transcription tool. No standalone voiceover software. No manual
      hashtag brainstorming. No last-minute publishing chaos.
    </p>

    <div class="feat__grid">
      {
        features.map((f) => (
          <article class="feat__card panel">
            <span class={`tile tile--${f.accent}`}>{f.key}</span>
            <h3>{f.title}</h3>
            <p class="muted">{f.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .feat__title {
    margin-top: 20px;
    font-size: clamp(28px, 4.4vw, 42px);
  }

  .feat__lead {
    margin-top: 16px;
    max-width: 44rem;
    font-size: 16px;
  }

  .feat__grid {
    margin-top: 44px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .feat__card {
    padding: 26px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    transition: transform 0.18s ease, border-color 0.2s ease;
  }

  .feat__card:hover {
    transform: translateY(-4px);
    border-color: rgba(45, 212, 191, 0.4);
  }

  .feat__card h3 {
    font-size: 19px;
  }

  .feat__card p {
    font-size: 14.5px;
  }

  @media (max-width: 900px) {
    .feat__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .feat__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
