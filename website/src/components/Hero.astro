---
import { downloads } from '../config/site.js';
const win = downloads.find((d) => d.id === 'windows');
---

<section class="hero">
  <div class="wrap hero__grid">
    <div class="hero__copy">
      <span class="eyebrow">AI Creator Studio</span>
      <h1 class="hero__title">
        Turn Raw Video into<br /><span class="hero__accent">Crafted Reels.</span>
      </h1>
      <p class="hero__lead">
        One intelligent workspace to transform raw footage into polished,
        engaging and ready-to-publish short-form content — captions, voiceovers,
        music, smart copy and scheduling in a single flow.
      </p>

      <div class="hero__actions">
        <a class="btn" href={win?.url} download>
          <span class="hero__win" aria-hidden="true">⊞</span>
          Download for Windows
        </a>
        <a class="btn btn--ghost" href="#download">macOS &amp; Linux — soon</a>
      </div>

      <p class="hero__meta">Free download · {win?.note} · Signed installer</p>
    </div>

    <div class="hero__visual panel">
      <div class="hv__row">
        <span class="hv__label">Raw Video</span>
        <span class="hv__label hv__label--teal">AI Crafting</span>
      </div>

      <div class="hv__body">
        <div class="hv__player">
          <span class="hv__play" aria-hidden="true"></span>
        </div>

        <div class="hv__stack">
          <span class="hv__chip hv__chip--violet">Voice</span>
          <span class="hv__chip hv__chip--teal">Caption</span>
          <span class="hv__chip hv__chip--pink">Style</span>
          <span class="hv__chip hv__chip--amber">Publish</span>
        </div>
      </div>

      <div class="hv__foot">
        Upload → Caption → Enhance → Voice → Style → Schedule → Publish
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(56px, 8vw, 104px);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(36px, 6vw, 76px);
    align-items: center;
  }

  .hero__title {
    margin-top: 22px;
    font-size: clamp(40px, 7vw, 68px);
    letter-spacing: -0.03em;
  }

  .hero__accent {
    color: var(--text);
    background: linear-gradient(100deg, #eef2f7 0%, #8fe9dd 60%, #2dd4bf 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero__lead {
    margin-top: 22px;
    max-width: 30rem;
    font-size: 17px;
    color: var(--text-dim);
  }

  .hero__actions {
    margin-top: 30px;
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .hero__win {
    font-size: 15px;
  }

  .hero__meta {
    margin-top: 16px;
    font-size: 13px;
    color: var(--text-mute);
  }

  /* ---- visual card ---- */
  .hero__visual {
    padding: 22px;
    box-shadow: var(--shadow);
  }

  .hv__row {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-mute);
  }

  .hv__label--teal {
    color: var(--teal);
  }

  .hv__body {
    margin-top: 16px;
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 16px;
  }

  .hv__player {
    border-radius: var(--radius-sm);
    background: radial-gradient(120% 120% at 50% 0%, #1a2431, #0c121b);
    border: 1px solid var(--line);
    min-height: 168px;
    display: grid;
    place-items: center;
  }

  .hv__play {
    width: 0;
    height: 0;
    border-style: solid;
    border-width: 15px 0 15px 26px;
    border-color: transparent transparent transparent var(--teal);
    filter: drop-shadow(0 6px 20px rgba(45, 212, 191, 0.5));
  }

  .hv__stack {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    align-content: start;
  }

  .hv__chip {
    display: grid;
    place-items: center;
    padding: 16px 8px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line);
    background: var(--panel-2);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .hv__chip--violet {
    color: #b3a7ff;
    border-color: rgba(139, 123, 246, 0.35);
  }
  .hv__chip--teal {
    color: var(--teal);
    border-color: rgba(45, 212, 191, 0.35);
  }
  .hv__chip--pink {
    color: #f78dbf;
    border-color: rgba(236, 72, 153, 0.35);
  }
  .hv__chip--amber {
    color: var(--amber);
    border-color: rgba(245, 177, 61, 0.35);
  }

  .hv__foot {
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid var(--line-soft);
    font-size: 11.5px;
    letter-spacing: 0.06em;
    color: var(--text-mute);
    text-align: center;
  }

  @media (max-width: 940px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }
    .hero__lead {
      max-width: none;
    }
  }

  @media (max-width: 460px) {
    .hv__body {
      grid-template-columns: 1fr;
    }
    .hv__foot {
      font-size: 10.5px;
    }
  }
</style>
